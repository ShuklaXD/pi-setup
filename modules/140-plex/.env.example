# Copy to .env (gitignored) if you want the server claimed automatically on its
# first start. Get a token from https://www.plex.tv/claim while signed in — it
# expires 4 MINUTES after it is issued, so paste it and run install.sh right away.
#
# This is entirely optional: leaving it blank just means you claim the server
# from the web UI instead (http://<pi-ip>:32400/web).
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx
